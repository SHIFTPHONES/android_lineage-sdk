android_app {
    name: "SHIFT-SettingsProvider",

    overrides: ["LineageSettingsProvider"],

    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],

    certificate: "platform",
    privileged: true,
    privapp_allowlist: "eco.shift.settingsstorage.xml",
    platform_apis: true,
    system_ext_specific: true,

    static_libs: [
        "org.lineageos.platform.internal",
    ],

    aaptflags: [
        "--rename-manifest-package",
        "eco.shift.settingsstorage",
    ],
}
